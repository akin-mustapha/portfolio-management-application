{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trading212Position",
  "type": "object",
  "properties": {
    "instrument": {
      "type": "object",
      "properties": {
        "ticker": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "isin": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "ticker",
        "isin"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "initialFillDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "quantity": {
      "type": "number"
    },
    "quantityAvailableForTrading": {
      "type": "number"
    },
    "averagePrice": {
      "type": "number"
    },
    "currentPrice": {
      "type": "number"
    },
    "ppl": {
      "type": "number"
    }
  },
  "required": [
    "instrument",
    "createdAt",
    "quantity"
  ]
}